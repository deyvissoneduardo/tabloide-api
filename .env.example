NODE_ENV=development
PORT=3000
LOG_LEVEL=debug
DATABASE_URL=postgres://tabloide:tabloide@localhost:5432/tabloide
DB_POOL_MAX=10
DB_SSL=false
JWT_SECRET=troque-por-um-segredo-com-32-caracteres-ou-mais
JWT_EXPIRES_IN=8h
ADMIN_API_KEY=troque-por-uma-chave-longa-de-no-minimo-32-caracteres
LOGIN_RATE_LIMIT=5
LOGIN_RATE_TTL_SECONDS=900
TENANT_STATUS_CACHE_TTL_MS=30000
PUBLIC_BASE_URL=http://localhost:5173
FUSO_HORARIO_PADRAO=America/Sao_Paulo
STORAGE_DRIVER=disco
# Com STORAGE_DRIVER=supabase (obrigatório em production):
# SUPABASE_URL=https://<projeto>.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=<chave de serviço; só no servidor>
SUPABASE_BUCKET=midia
MIDIA_DIR_LOCAL=./.midia
MIDIA_URL_BASE_LOCAL=http://localhost:3000/v1/midia-local
MAX_IMAGEM_BYTES=10485760
IMAGEM_MAX_PIXELS=50000000
IMAGEM_CONCORRENCIA=2
# Fase 5: produção
# DATABASE_URL_MIGRATIONS=postgres://...:5432/... (porta 5432; a app usa o transaction pooler 6543)
TRUST_PROXY=1
CORS_ORIGENS_PAINEL=http://localhost:5173
PUBLICO_CACHE_MAX=5000
PUBLICO_CACHE_TTL_MAX_SEG=60
PUBLICO_CACHE_NEGATIVO_SEG=10
PUBLICO_CACHE_DESATIVADO=false
PUBLICO_RATE_LIMIT_POR_MIN=300
PAINEL_RATE_LIMIT_POR_MIN=600
SHUTDOWN_DRENAGEM_MS=5000
SHUTDOWN_TIMEOUT_MS=10000
# /docs e /docs-json (OpenAPI); mantenha false em produção
SWAGGER_HABILITADO=true
