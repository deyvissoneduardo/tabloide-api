{
  "name": "tabloide-api",
  "version": "0.1.0",
  "description": "Tabloide Digital API",
  "scripts": {
    "start:dev": "node scripts/start-dev.js",
    "build": "nest build",
    "start:prod": "node dist/main.js",
    "lint": "eslint \"src/**/*.ts\" \"test/**/*.ts\"",
    "format": "prettier --write .",
    "test": "jest --selectProjects unit",
    "test:int": "jest --selectProjects integration --runInBand",
    "test:cov": "jest --selectProjects unit --coverage",
    "db:up": "docker compose up -d postgres",
    "db:migrate": "sequelize-cli db:migrate",
    "db:migrate:undo:all": "sequelize-cli db:migrate:undo:all",
    "db:seed": "sequelize-cli db:seed:all",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "seed:carga": "node scripts/seed-carga.js",
    "release": "bash scripts/release.sh",
    "proteger:main": "bash scripts/proteger-main.sh"
  },
  "license": "UNLICENSED",
  "type": "commonjs",
  "dependencies": {
    "@nestjs/common": "^11.2.7",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.2.7",
    "@nestjs/event-emitter": "^3.1.0",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/platform-express": "^11.2.7",
    "@nestjs/sequelize": "^11.0.1",
    "@nestjs/serve-static": "^5.0.5",
    "@nestjs/swagger": "^11.4.7",
    "@nestjs/throttler": "^6.7.1",
    "@node-rs/argon2": "^2.2.2",
    "@supabase/supabase-js": "^2.118.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "compression": "^1.8.1",
    "file-type": "^16.5.4",
    "helmet": "^8.1.0",
    "lru-cache": "^11.5.3",
    "nanoid": "^3.3.20",
    "nestjs-cls": "^7.0.1",
    "nestjs-pino": "^5.3.1",
    "p-limit": "^3.1.0",
    "pg": "^8.23.1",
    "pg-hstore": "^2.3.4",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "prom-client": "^15.1.3",
    "qrcode": "^1.5.4",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "sequelize": "^6.37.8",
    "sequelize-typescript": "^2.1.6",
    "sharp": "^0.35.5",
    "uuid": "^11.1.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.24",
    "@nestjs/testing": "^11.2.7",
    "@testcontainers/postgresql": "^12.2.1",
    "@types/compression": "^1.8.1",
    "@types/express": "^5.0.6",
    "@types/jest": "^29.5.14",
    "@types/multer": "^2.3.0",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "@types/pngjs": "^6.0.5",
    "@types/qrcode": "^1.5.6",
    "@types/supertest": "^7.2.1",
    "eslint": "^10.13.0",
    "jest": "^29.7.0",
    "jsqr": "^1.4.0",
    "pino-pretty": "^13.2.0",
    "pngjs": "^7.0.0",
    "prettier": "^3.9.10",
    "sequelize-cli": "^6.6.5",
    "supabase": "^2.121.0",
    "supertest": "^7.3.1",
    "ts-jest": "^29.4.15",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.2",
    "umzug": "^3.8.3"
  },
  "private": true,
  "engines": {
    "node": "22.x"
  }
}
